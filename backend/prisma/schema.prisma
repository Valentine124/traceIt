// TraceIt — Prisma schema
// Design notes:
// - Soft deletion (`deletedAt`) on entities users can "remove" but that must be
//   auditable/recoverable (User, Organization, Project, Report).
// - Reporter identity is split from report content: `Report` never stores PII;
//   `ReportIdentity` is a separate 1:0..1 table with stricter access control,
//   so "anonymous" is architecturally enforced, not just a UI flag.
// - AI output is stored in `AIInteraction`, never mixed into authoritative
//   `Source`/`Project` records — the app layer must promote it explicitly.
// - Append-only `AuditLog` — rows are never updated/deleted by app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum RoleName {
  CITIZEN
  VERIFIER
  ORGANIZATION_ADMIN
  SYSTEM_ADMIN
}

enum AuthProvider {
  PHONE_OTP
  EMAIL_PASSWORD
  ANONYMOUS
}

enum ProjectCategory {
  HEALTHCARE
  EDUCATION
  ROADS
  WATER
  ELECTRICITY
  OTHER
}

enum ProjectStatus {
  PLANNED
  ONGOING
  DELAYED
  COMPLETED
  ABANDONED
  DISPUTED
}

enum SourceType {
  GOVERNMENT_PUBLICATION
  BUDGET_DOCUMENT
  CONTRACT
  NEWS_ARTICLE
  PRESS_RELEASE
  AUDIT_REPORT
  OTHER
}

enum RecordOrigin {
  OFFICIAL_SOURCE
  COMMUNITY_EVIDENCE
  AI_GENERATED
}

enum EvidenceType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  LOCATION
}

enum EvidenceVisibility {
  PRIVATE
  VERIFIER_ONLY
  PUBLIC
}

enum ReportStatus {
  RECEIVED
  UNDER_REVIEW
  NEEDS_MORE_EVIDENCE
  VERIFICATION
  VERIFIED
  DISPUTED
  RESOLVED
  CLOSED
}

enum ReportVisibility {
  ANONYMOUS
  PROTECTED
  PUBLIC
}

enum VerificationOutcome {
  VERIFIED
  DISPUTED
  NEEDS_MORE_EVIDENCE
  ESCALATED
  INSUFFICIENT_EVIDENCE
}

enum CivicRealityStatus {
  POTENTIAL_DISCREPANCY
  NEEDS_VERIFICATION
  INSUFFICIENT_EVIDENCE
  VERIFIED
  CONFLICTING_INFORMATION
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum NotificationEvent {
  REPORT_CREATED
  REPORT_STATUS_CHANGED
  EVIDENCE_VERIFIED
  INSTITUTION_RESPONSE_RECEIVED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum Language {
  EN
  FR
  PT
  AR
  HA
  YO
  IG
}

// ---------- USERS, ORGS, RBAC ----------

model User {
  id            String       @id @default(uuid())
  phone         String?      @unique
  email         String?      @unique
  passwordHash  String?
  displayName   String?
  preferredLang Language     @default(EN)
  authProvider  AuthProvider @default(PHONE_OTP)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  roles              UserRole[]
  organizationLinks  OrganizationMember[]
  verificationReviews VerificationReview[]
  aiInteractions     AIInteraction[]
  auditLogs          AuditLog[]
  reportIdentity     ReportIdentity[]

  @@index([phone])
  @@index([email])
}

model Role {
  id          String  @id @default(uuid())
  name        RoleName @unique
  description String?

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique // e.g. "reports:verify", "projects:write"
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?
  country     String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members             OrganizationMember[]
  institutionResponses InstitutionResponse[]
  projects            Project[]

  @@index([country])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ---------- PROJECTS ----------

model Project {
  id                  String          @id @default(uuid())
  name                String
  description         String
  category            ProjectCategory
  country             String
  region              String?
  community           String?
  latitude            Float?
  longitude           Float?
  budgetAmount         Decimal?        @db.Decimal(18, 2)
  budgetCurrency       String?
  contractor           String?
  responsibleOrgId     String?
  startDate            DateTime?
  expectedCompletion   DateTime?
  actualCompletion     DateTime?
  deliverables         String[]
  status               ProjectStatus   @default(PLANNED)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  responsibleOrg  Organization?         @relation(fields: [responsibleOrgId], references: [id])
  statusHistory   ProjectStatusHistory[]
  sources         ProjectSource[]
  evidence        Evidence[]
  reports         Report[]

  @@index([category])
  @@index([country, region])
  @@index([status])
  @@index([community])
}

model ProjectStatusHistory {
  id        String        @id @default(uuid())
  projectId String
  status    ProjectStatus
  note      String?
  changedAt DateTime      @default(now())
  changedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, changedAt])
}

// ---------- SOURCES ----------

model Source {
  id               String       @id @default(uuid())
  title            String
  url              String?
  publisher        String
  sourceType       SourceType
  origin           RecordOrigin @default(OFFICIAL_SOURCE)
  publicationDate  DateTime?
  verificationDate DateTime?
  contentHash      String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  projects ProjectSource[]

  @@index([sourceType])
  @@index([origin])
}

model ProjectSource {
  projectId String
  sourceId  String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([projectId, sourceId])
}

// ---------- EVIDENCE ----------

model Evidence {
  id           String             @id @default(uuid())
  projectId    String?
  reportId     String?
  submittedBy  String?
  type         EvidenceType
  storageKey   String? // object storage key, not a public URL
  mimeType     String?
  fileSizeBytes Int?
  textContent  String?
  latitude     Float?
  longitude    Float?
  capturedAt   DateTime?
  visibility   EvidenceVisibility @default(PRIVATE)
  origin       RecordOrigin       @default(COMMUNITY_EVIDENCE)
  isVerified   Boolean            @default(false)
  createdAt    DateTime           @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  report  Report?  @relation(fields: [reportId], references: [id])

  @@index([projectId])
  @@index([reportId])
  @@index([visibility])
}

// ---------- REPORTS ----------

model Report {
  id             String           @id @default(uuid())
  trackingId     String           @unique @default(uuid()) // safe to hand to the reporter
  projectId      String?
  title          String
  description    String
  status         ReportStatus     @default(RECEIVED)
  visibility     ReportVisibility @default(PROTECTED)
  language       Language         @default(EN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  project             Project?               @relation(fields: [projectId], references: [id])
  statusHistory       ReportStatusHistory[]
  evidence            Evidence[]
  verificationReviews VerificationReview[]
  institutionResponses InstitutionResponse[]
  identity            ReportIdentity?
  notifications       Notification[]

  @@index([status])
  @@index([projectId])
}

// Deliberately separate table + narrower access path than Report itself.
// Absent entirely for ANONYMOUS reports.
model ReportIdentity {
  reportId  String   @id
  userId    String?
  contactPhone String?
  contactEmail String?
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
}

model ReportStatusHistory {
  id        String       @id @default(uuid())
  reportId  String
  status    ReportStatus
  note      String?
  changedAt DateTime     @default(now())
  changedBy String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, changedAt])
}

// ---------- VERIFICATION ----------

model VerificationReview {
  id         String              @id @default(uuid())
  reportId   String
  verifierId String
  outcome    VerificationOutcome
  notes      String?
  escalated  Boolean             @default(false)
  createdAt  DateTime            @default(now())

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  verifier User   @relation(fields: [verifierId], references: [id])

  @@index([reportId])
  @@index([verifierId])
}

// ---------- INSTITUTION RESPONSES ----------

model InstitutionResponse {
  id             String   @id @default(uuid())
  reportId       String
  organizationId String
  body           String
  attachmentKeys String[]
  isModerated    Boolean  @default(false)
  createdAt      DateTime @default(now())

  report       Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([reportId])
}

// ---------- NOTIFICATIONS ----------

model Notification {
  id        String              @id @default(uuid())
  userId    String?
  reportId  String?
  event     NotificationEvent
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  payload   Json?
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  report Report? @relation(fields: [reportId], references: [id])

  @@index([status])
  @@index([userId])
}

// ---------- USSD / SMS ----------

model USSDSession {
  id         String   @id @default(uuid())
  sessionId  String   @unique // provider session id (e.g. Africa's Talking)
  phone      String
  stage      String
  contextJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime

  @@index([phone])
  @@index([expiresAt])
}

model SMSMessage {
  id            String   @id @default(uuid())
  direction     String // "inbound" | "outbound"
  phone         String
  body          String
  providerMsgId String?  @unique // used for idempotent webhook processing
  createdAt     DateTime @default(now())

  @@index([phone])
}

// ---------- AI ----------

model AIInteraction {
  id           String   @id @default(uuid())
  userId       String?
  requestType  String // e.g. "qa", "summarize", "civic_reality_check"
  inputSummary String?
  outputJson   Json
  modelName    String
  confidence   Float?
  requiresReview Boolean @default(true)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([requestType])
}

// ---------- LOCALIZATION ----------

model Translation {
  id        String   @id @default(uuid())
  namespace String // e.g. "ussd", "reports"
  key       String
  language  Language
  value     String
  updatedAt DateTime @updatedAt

  @@unique([namespace, key, language])
}

// ---------- AUDIT (append-only by convention; enforce in app layer) ----------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // e.g. "REPORT_STATUS_CHANGED", "LOGIN_SUCCESS"
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
