# =============================================================================
# TraceIt backend — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
# Why required: primary datastore for all relational data.
# Where to get it: local Docker Compose provides one automatically; in
#   production use your host's connection string (Render/Railway/RDS/etc).
# Required for local dev: YES (Docker Compose provisions it for you).
# Sandbox/test mode: use a separate `traceit_test` database for tests.
# Cost: free locally; managed Postgres has a cost in production.
# If not configured: the app refuses to start (fail-fast validation).
DATABASE_URL=postgresql://traceit:traceit_dev_password@localhost:5432/traceit

# --- Redis ---------------------------------------------------------------
# Why required: OTP storage, token revocation, USSD session state, BullMQ queues.
# Where to get it: local Docker Compose provides one; managed Redis (Upstash,
#   Redis Cloud, ElastiCache) in production.
# Required for local dev: YES.
# Sandbox/test mode: N/A — Redis has no concept of sandbox; use a separate
#   local instance/db index for tests.
# Cost: free locally; managed Redis has a cost in production.
# If not configured: the app refuses to start.
REDIS_URL=redis://localhost:6379

# --- JWT secrets ---------------------------------------------------------
# Why required: signs access/refresh tokens.
# Where to get it: generate yourself, e.g. `openssl rand -base64 48`.
# Required for local dev: YES.
# Sandbox/test mode: N/A.
# Cost: free.
# If not configured: the app refuses to start (must be >= 32 chars).
JWT_ACCESS_SECRET=replace-with-a-random-64-char-secret-________________________
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret______________
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins, or "*" for all (dev only).
CORS_ORIGINS=*

# --- AI provider (e.g. Anthropic/OpenAI) ------------------------------------
# Why required: powers document summarization, Q&A, and civic reality checks.
# Where to get it: https://console.anthropic.com or your chosen provider's console.
# Used for: AI module (§7) — summarization, translation, discrepancy detection.
# Required for local dev: NO — falls back to a deterministic mock responder
#   so the AI module's control flow can still be exercised.
# Sandbox/test mode: most providers offer free-tier or pay-as-you-go testing.
# Cost: YES, usage-based.
# If not configured: AI endpoints return mock/stubbed structured responses
#   with requiresHumanReview=true, clearly flagged as non-live.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# --- Object storage (S3-compatible) -----------------------------------------
# Why required: stores evidence media (images/audio/video) — never in Postgres.
# Where to get it: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO (local).
# Required for local dev: NO — run MinIO via Docker for a local S3-compatible
#   endpoint, or leave unset to disable media upload locally.
# Sandbox/test mode: MinIO locally is a free full-fidelity sandbox.
# Cost: YES in production (usage-based); MinIO locally is free.
# If not configured: evidence upload endpoints return 503 with a clear message.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Africa's Talking (USSD + SMS) ------------------------------------------
# Why required: powers USSD menus and SMS notifications/commands.
# Where to get it: https://account.africastalking.com (free sandbox app available).
# Required for local dev: NO — a mock adapter logs outgoing SMS instead of sending.
# Sandbox/test mode: YES, Africa's Talking provides a free sandbox environment.
# Cost: sandbox is free; production SMS/USSD usage is billed per message/session.
# If not configured: SMS sends are logged locally instead of delivered; USSD
#   webhook still works end-to-end against your own test client.
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SHORTCODE=

# --- Email provider ----------------------------------------------------------
# Why required: email auth flows and email notifications.
# Where to get it: e.g. Resend, SendGrid, Postmark.
# Required for local dev: NO — falls back to logging the email instead of sending.
# Sandbox/test mode: most providers offer a free tier.
# Cost: YES at scale; most have a free tier for low volume.
# If not configured: email notifications are logged, not delivered.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- SMS webhook secret ------------------------------------------------------
# Why required: verifies inbound SMS webhook requests actually come from your
#   configured provider (prevents webhook spoofing).
# Where to get it: set your own value and configure it on the provider side,
#   or use the provider's signature-verification scheme if it offers one.
# Required for local dev: NO.
# Cost: free.
# If not configured: inbound SMS webhook logs a warning but still processes
#   requests — set this before going to production.
SMS_WEBHOOK_SECRET=
